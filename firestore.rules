rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection health check document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Daily DOE Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId);
      allow list: if true;
      allow create: if isValidId(reportId)
        && incoming().id is string
        && incoming().officeId is string;
      allow update: if isValidId(reportId)
        && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(reportId);
    }

    // Employment Offices & Mobile Units
    match /offices/{officeId} {
      allow get: if isValidId(officeId);
      allow list: if true;
      allow create: if isValidId(officeId)
        && incoming().id is string
        && incoming().name is string
        && incoming().region is string;
      allow update: if isValidId(officeId)
        && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(officeId);
    }

    // Work Permit Report Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId)
        && incoming().id is string
        && incoming().code is string
        && incoming().title is string;
      allow update: if isValidId(categoryId)
        && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(categoryId);
    }

    // Queue Metric Categories (สถานะคิวและการให้บริการ)
    match /queue_metrics/{metricId} {
      allow get: if isValidId(metricId);
      allow list: if true;
      allow create, update: if isValidId(metricId)
        && incoming().id is string
        && incoming().title is string;
      allow delete: if isValidId(metricId);
    }

    // Reporters Directory
    match /reporters/{reporterId} {
      allow get: if isValidId(reporterId);
      allow list: if true;
      allow create: if isValidId(reporterId)
        && incoming().id is string
        && incoming().name is string
        && incoming().position is string;
      allow update: if isValidId(reporterId)
        && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(reporterId);
    }

    // System Branding & Config
    match /system_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update: if isValidId(configId)
        && incoming().reportTitle is string
        && incoming().adminPin is string;
      allow delete: if false;
    }

    // Recycle bin archive for deleted reports
    match /deleted_reports/{reportId} {
      allow get, delete: if isValidId(reportId);
      allow list: if true;
      allow create, update: if isValidId(reportId);
    }

    // Recycle bin archive for deleted offices
    match /deleted_offices/{officeId} {
      allow get, delete: if isValidId(officeId);
      allow list: if true;
      allow create, update: if isValidId(officeId);
    }

    // System Issues & Trouble Reports from Assistant Mascot
    match /system_issues/{issueId} {
      allow get, list: if true;
      allow create, update: if isValidId(issueId)
        && incoming().id is string
        && incoming().issueType is string
        && incoming().title is string;
      allow delete: if isValidId(issueId);
    }
  }
}
